{
  // Deployment on Cloudflare Workers: the game's static files, and Aïcha's online answers at /api/aicha.
  "name": "patchbay",
  "compatibility_date": "2026-10-01",
  "main": "functions/worker.ts",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
